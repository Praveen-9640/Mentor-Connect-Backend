# Backend environment variables — placeholders only, NO real values.
# Copy the values you need into your local shell / Render service and NEVER commit them.
#
# Required (the backend will not start without these):
DB_URL=jdbc:mysql://your-tidb-host:4000/mentorconnect?sslMode=VERIFY_CA
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional — only needed to pin the TLS CA explicitly when the JVM default
# truststore is not sufficient (the public ISRG Root X1 cert that validates
# TiDB Cloud is already trusted by the JVM, so this is usually unnecessary).
# DB_CA_PATH=/path/to/ca.pem
